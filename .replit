modules = ["nodejs-20", "python-3.11", "web"]

    [deployment]
    router = "application"
    deploymentTarget = "autoscale"

    [deployment.postBuild]
    args = ["pnpm", "store", "prune"]
    env = { "CI" = "true" }

    [workflows]

    [agent]
    stack = "PNPM_WORKSPACE"
    expertMode = true

    [postMerge]
    path = "scripts/post-merge.sh"
    timeoutMs = 20000

    [nix]
channel = "stable-25_05"

    [userenv]

    [userenv.shared]
    EVALS_MODE = "1"
OLLAMA_HOST = "https://107b-2003-cb-5f1b-adc8-58f8-bea5-33e-6875.ngrok-free.app/v1"
VITE_OLLAMA_BASE_URL = "https://107b-2003-cb-5f1b-adc8-58f8-bea5-33e-6875.ngrok-free.app"
CUSTOM_API_BASE_URL = "https://107b-2003-cb-5f1b-adc8-58f8-bea5-33e-6875.ngrok-free.app/v1"
CUSTOM_API_MODEL = "deepseek-r1:8b"

    [userenv.development]
    AUTO_LAUNCH_OLLAMA = "false"
    BASE_PATH = "/"
    LOCAL_AUTH_BYPASS = "true"
    LOCAL_MOCK_PROVIDER = "false"
    NODE_ENV = "development"
    