modules = ["nodejs-20", "python-3.11", "web"]
[agent]
expertMode = true
stack = "FLASK_VANILLA_JS"
integrations = ["javascript_openai_ai_integrations:2.0.0", "javascript_anthropic_ai_integrations:2.0.0"]

[nix]
channel = "stable-25_05"
packages = ["cacert", "cargo", "freetype", "glibcLocales", "iana-etc", "lcms2", "libiconv", "libimagequant", "libjpeg", "libtiff", "libwebp", "libxcrypt", "openjpeg", "openssl", "pkg-config", "postgresql", "rustc", "tcl", "tk", "zlib"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python main.py"
waitForPort = 5000

[userenv]

[userenv.shared]
NODE_ENV = "development"
PORT = "8080"
APP_URL = "https://${REPLIT_DEV_DOMAIN}"
FRONTEND_URL = "https://${REPLIT_DEV_DOMAIN}"
API_BASE_URL = "https://${REPLIT_DEV_DOMAIN}"
ALLOWED_ORIGINS = "https://${REPLIT_DEV_DOMAIN}"
APP_VERSION = "1.0.0"
STORAGE_PROVIDER = "local"
LOCAL_UPLOAD_DIR = "./uploads"

[deployment]
deploymentTarget = "autoscale"
run = ["gunicorn", "--bind", "0.0.0.0:5000", "main:app"]
build = ["bash", "-c", "cd artifacts/api-server && pnpm run build && cd ../mr7-ai && pnpm run build"]

[[ports]]
localPort = 3000
externalPort = 3000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 8083
externalPort = 3003

[[ports]]
localPort = 22938
externalPort = 3001
