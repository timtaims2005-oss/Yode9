modules = ["nodejs-20", "python-3.11", "web"]

    [deployment]
    router = "application"
    deploymentTarget = "autoscale"

    [deployment.postBuild]
    args = ["pnpm", "store", "prune"]
    env = { "CI" = "true" }

    [workflows]

    [agent]
    stack = "PNPM_WORKSPACE"
    expertMode = true

    [postMerge]
    path = "scripts/post-merge.sh"
    timeoutMs = 20000

    [nix]
    channel = "stable-25_05"

    [userenv]

    [userenv.shared]
    EVALS_MODE = "1"
    VITE_OLLAMA_API_KEY = "rayan1212"
    OLLAMA_HOST = "https://230b-2003-cb-5f1b-adc8-9145-de1e-fa46-3351.ngrok-free.app"
    VITE_OLLAMA_BASE_URL = "https://230b-2003-cb-5f1b-adc8-9145-de1e-fa46-3351.ngrok-free.app"

    [userenv.development]
    AUTO_LAUNCH_OLLAMA = "false"
    BASE_PATH = "/"
    LOCAL_AUTH_BYPASS = "true"
    LOCAL_MOCK_PROVIDER = "false"
    NODE_ENV = "development"
    