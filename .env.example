# ══════════════════════════════════════════════════════════════════════════════
# MR7-AI Platform — Environment Variables Reference
# Copy this file to .env and fill in the values before launching.
# Lines marked REQUIRED must be set for the relevant feature to work.
# Lines marked OPTIONAL have sensible defaults or gracefully disable the feature.
# ══════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────
# CORE SERVER
# ─────────────────────────────────────────────────────────────────────────────
NODE_ENV=production                          # development | production
PORT=8080                                    # API server port (default 8080)
APP_URL=https://your-domain.com              # REQUIRED — base URL (used in Stripe redirects, emails)
ALLOWED_ORIGINS=https://your-domain.com      # OPTIONAL — comma-separated CORS whitelist

# ─────────────────────────────────────────────────────────────────────────────
# DATABASE & CACHE
# ─────────────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:pass@host:5432/mr7ai   # REQUIRED — PostgreSQL connection string
REDIS_URL=redis://localhost:6379                       # OPTIONAL — Redis (BullMQ, session, cache; falls back to in-memory)

# ─────────────────────────────────────────────────────────────────────────────
# AUTHENTICATION — Clerk (primary auth)
# ─────────────────────────────────────────────────────────────────────────────
CLERK_SECRET_KEY=sk_live_...                 # REQUIRED — backend secret (Clerk dashboard → API Keys)
CLERK_PUBLISHABLE_KEY=pk_live_...           # REQUIRED — frontend key  (Clerk dashboard → API Keys)
# Mobile app uses the same publishable key:
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_... # REQUIRED for mobile app

# ─────────────────────────────────────────────────────────────────────────────
# AUTHENTICATION — JWT fallback (if not using Clerk)
# ─────────────────────────────────────────────────────────────────────────────
JWT_PRIVATE_KEY=                             # OPTIONAL — RSA-2048 private key (PEM, base64-encoded)
JWT_PUBLIC_KEY=                              # OPTIONAL — RSA-2048 public key  (PEM, base64-encoded)
JWT_EXPIRES_IN=7d                            # OPTIONAL — token TTL (default: 7d)

# ─────────────────────────────────────────────────────────────────────────────
# AUTHENTICATION — Session & Security
# ─────────────────────────────────────────────────────────────────────────────
SESSION_SECRET=change-me-to-a-random-64-char-string  # REQUIRED — Express session signing key
INTERNAL_API_KEY=                            # OPTIONAL — internal service-to-service key (generate with: openssl rand -hex 32)
ADMIN_SECRET=                                # OPTIONAL — legacy admin activation code
AES_ENCRYPTION_KEY=                          # OPTIONAL — 32-byte hex key for at-rest encryption (openssl rand -hex 32)
ENCRYPTION_KEY=                              # OPTIONAL — alias used by some crypto utilities

# ─────────────────────────────────────────────────────────────────────────────
# PAYMENTS — Stripe
# ─────────────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...                # REQUIRED for payments (stripe.com → Developers → API keys)
STRIPE_WEBHOOK_SECRET=whsec_...             # REQUIRED for webhooks  (stripe.com → Webhooks → Signing secret)
STRIPE_PRO_PRICE_ID=price_...               # REQUIRED — Pro plan price ID (Stripe dashboard → Products)
STRIPE_ENTERPRISE_PRICE_ID=price_...        # REQUIRED — Enterprise plan price ID

# ─────────────────────────────────────────────────────────────────────────────
# AI PROVIDERS — Primary
# ─────────────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...                        # REQUIRED for GPT models (platform.openai.com → API keys)
ANTHROPIC_API_KEY=sk-ant-...                 # OPTIONAL — Claude models (console.anthropic.com)
GROQ_API_KEY=gsk_...                        # OPTIONAL — Groq fast inference (console.groq.com)
GEMINI_API_KEY=                              # OPTIONAL — Google Gemini (aistudio.google.com)
GOOGLE_AI_API_KEY=                           # OPTIONAL — alias for Gemini
OPENROUTER_API_KEY=                          # OPTIONAL — OpenRouter multi-model proxy (openrouter.ai)

# ─────────────────────────────────────────────────────────────────────────────
# AI PROVIDERS — Replit AI Integrations proxy (alternative to direct keys)
# ─────────────────────────────────────────────────────────────────────────────
AI_INTEGRATIONS_OPENAI_API_KEY=              # OPTIONAL — Replit-managed OpenAI proxy key
AI_INTEGRATIONS_OPENAI_BASE_URL=             # OPTIONAL — Replit-managed OpenAI base URL
AI_INTEGRATIONS_ANTHROPIC_API_KEY=           # OPTIONAL — Replit-managed Anthropic proxy key

# ─────────────────────────────────────────────────────────────────────────────
# AI PROVIDERS — Local / Self-hosted
# ─────────────────────────────────────────────────────────────────────────────
OLLAMA_HOST=http://localhost:11434           # OPTIONAL — Ollama endpoint for local LLMs
OLLAMA_BIN=/usr/local/bin/ollama            # OPTIONAL — path to Ollama binary (auto-launch)
PERSONAL_API_KEY=                            # OPTIONAL — custom OpenAI-compatible endpoint key
PERSONAL_BASE_URL=                           # OPTIONAL — custom endpoint base URL
PERSONAL_DEFAULT_MODEL=                      # OPTIONAL — default model for custom endpoint

# ─────────────────────────────────────────────────────────────────────────────
# CLOUDFLARE
# ─────────────────────────────────────────────────────────────────────────────
CLOUDFLARE_ACCOUNT_ID=                       # OPTIONAL — Workers AI + R2 storage
CLOUDFLARE_API_TOKEN=                        # OPTIONAL — Cloudflare API token

# ─────────────────────────────────────────────────────────────────────────────
# EMAIL
# ─────────────────────────────────────────────────────────────────────────────
RESEND_API_KEY=re_...                        # OPTIONAL — Resend email API (resend.com → API Keys)

# ─────────────────────────────────────────────────────────────────────────────
# MONITORING & OBSERVABILITY
# ─────────────────────────────────────────────────────────────────────────────
SENTRY_DSN=https://...@sentry.io/...        # OPTIONAL — error tracking (sentry.io → Project → DSN)

# ─────────────────────────────────────────────────────────────────────────────
# OSINT — Free tiers (no key required for basic use)
# ─────────────────────────────────────────────────────────────────────────────
HIBP_API_KEY=                                # OPTIONAL — Have I Been Pwned (haveibeenpwned.com/API/Key)
IPINFO_API_KEY=                              # OPTIONAL — ipinfo.io higher rate limits (ipinfo.io/account)

# ─────────────────────────────────────────────────────────────────────────────
# OSINT — Premium feeds (Task #3 — connect when ready)
# ─────────────────────────────────────────────────────────────────────────────
SHODAN_API_KEY=                              # OPTIONAL — Shodan search API (account.shodan.io)
VT_API_KEY=                                  # OPTIONAL — VirusTotal threat intel (virustotal.com/gui/my-apikey)
GREYNOISE_API_KEY=                           # OPTIONAL — GreyNoise IP context (viz.greynoise.io/account)
CENSYS_API_ID=                               # OPTIONAL — Censys internet scan (search.censys.io/account/api)
CENSYS_API_SECRET=                           # OPTIONAL — Censys secret
URLSCAN_API_KEY=                             # OPTIONAL — URLScan.io (urlscan.io/user/profile)
FLASHPOINT_API_KEY=                          # OPTIONAL — Flashpoint dark web intel
SPYCLOUD_API_KEY=                            # OPTIONAL — SpyCloud breach data
ANOMALI_API_KEY=                             # OPTIONAL — Anomali ThreatStream
KELA_API_KEY=                                # OPTIONAL — KELA cyber intelligence
ONYPHE_API_KEY=                              # OPTIONAL — Onyphe internet scanner

# ─────────────────────────────────────────────────────────────────────────────
# INTEGRATIONS
# ─────────────────────────────────────────────────────────────────────────────
GITHUB_TOKEN=ghp_...                         # OPTIONAL — GitHub repo tools (github.com → Settings → Tokens)
BRAVE_SEARCH_API_KEY=                        # OPTIONAL — Brave Search for AI agent web browsing
TELEGRAM_BOT_TOKEN=                          # OPTIONAL — Telegram notification bot
LINEAR_API_KEY=                              # OPTIONAL — Linear project management
NOTION_KEY=                                  # OPTIONAL — Notion integration

# ─────────────────────────────────────────────────────────────────────────────
# STORAGE & BACKUPS
# ─────────────────────────────────────────────────────────────────────────────
# S3-compatible object storage (AWS S3, Cloudflare R2, MinIO, etc.)
S3_ENDPOINT=                                 # OPTIONAL — S3/R2 endpoint URL
S3_BUCKET=                                   # OPTIONAL — bucket name
S3_ACCESS_KEY_ID=                            # OPTIONAL — access key
S3_SECRET_ACCESS_KEY=                        # OPTIONAL — secret key
S3_REGION=auto                               # OPTIONAL — region (use "auto" for R2)

BACKUP_ENABLED=false                         # OPTIONAL — enable automated DB backups
BACKUP_DIR=./backups                         # OPTIONAL — local backup directory
BACKUP_SCHEDULE=0 3 * * *                    # OPTIONAL — cron schedule (default: 3am daily)
BACKUP_KEEP_DAYS=7                           # OPTIONAL — days to retain backups

# ─────────────────────────────────────────────────────────────────────────────
# ELASTICSEARCH (optional search indexing)
# ─────────────────────────────────────────────────────────────────────────────
ELASTICSEARCH_URL=                           # OPTIONAL — Elasticsearch endpoint
ELASTICSEARCH_USER=                          # OPTIONAL — username
ELASTICSEARCH_PASS=                          # OPTIONAL — password
